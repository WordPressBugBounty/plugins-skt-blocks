{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "skt-blocks/grid",
  "title": "Grid Block",
  "category": "skt_blocks",
  "description": "A responsive grid of columns. Add columns and control the horizontal/vertical gap per device.",
  "keywords": [
    "grid",
    "columns",
    "row",
    "layout",
    "container"
  ],
  "textdomain": "skt-blocks",
  "supports": {
    "anchor": true,
    "customClassName": true,
    "html": false,
    "align": [
      "wide",
      "full"
    ],
    "reusable": true
  },
  "attributes": {
    "uniqueId": {
      "type": "string",
      "default": ""
    },
    "tagName": {
      "type": "string",
      "default": "div"
    },
    "layout": {
      "type": "string",
      "default": "50-50"
    },
    "columnWidths": {
      "type": "array",
      "default": [
        50,
        50
      ]
    },
    "columns": {
      "type": "number",
      "default": 2
    },
    "columnsTablet": {
      "type": "number"
    },
    "columnsMobile": {
      "type": "number",
      "default": 1
    },
    "horizontalGap": {
      "type": "number",
      "default": 20
    },
    "horizontalGapTablet": {
      "type": "number"
    },
    "horizontalGapMobile": {
      "type": "number"
    },
    "verticalGap": {
      "type": "number",
      "default": 20
    },
    "verticalGapTablet": {
      "type": "number"
    },
    "verticalGapMobile": {
      "type": "number"
    },
    "verticalAlignment": {
      "type": "string",
      "default": ""
    },
    "horizontalAlignment": {
      "type": "string",
      "default": ""
    },
    "backgroundType": {
      "type": "string",
      "default": "color"
    },
    "backgroundColor": {
      "type": "string"
    },
    "gradientColor": {
      "type": "string"
    },
    "backgroundImageUrl": {
      "type": "string"
    },
    "backgroundImageId": {
      "type": "number"
    },
    "backgroundPosition": {
      "type": "string",
      "default": "center center"
    },
    "backgroundSize": {
      "type": "string",
      "default": "cover"
    },
    "backgroundRepeat": {
      "type": "string",
      "default": "no-repeat"
    },
    "backgroundAttachment": {
      "type": "string",
      "default": "scroll"
    },
    "overlayType": {
      "type": "string",
      "default": "none"
    },
    "overlayColor": {
      "type": "string"
    },
    "overlayGradient": {
      "type": "string"
    },
    "overlayOpacity": {
      "type": "number",
      "default": 50
    },
    "paddingUnit": {
      "type": "string",
      "default": "px"
    },
    "marginUnit": {
      "type": "string",
      "default": "px"
    },
    "paddingTop": {
      "type": "number",
      "default": 0
    },
    "paddingRight": {
      "type": "number",
      "default": 0
    },
    "paddingBottom": {
      "type": "number",
      "default": 0
    },
    "paddingLeft": {
      "type": "number",
      "default": 0
    },
    "paddingTopTablet": {
      "type": "number"
    },
    "paddingRightTablet": {
      "type": "number"
    },
    "paddingBottomTablet": {
      "type": "number"
    },
    "paddingLeftTablet": {
      "type": "number"
    },
    "paddingTopMobile": {
      "type": "number"
    },
    "paddingRightMobile": {
      "type": "number"
    },
    "paddingBottomMobile": {
      "type": "number"
    },
    "paddingLeftMobile": {
      "type": "number"
    },
    "marginTop": {
      "type": "number",
      "default": 0
    },
    "marginBottom": {
      "type": "number",
      "default": 0
    },
    "marginTopTablet": {
      "type": "number"
    },
    "marginBottomTablet": {
      "type": "number"
    },
    "marginTopMobile": {
      "type": "number"
    },
    "marginBottomMobile": {
      "type": "number"
    },
    "fontFamily": {
      "type": "string"
    },
    "fontWeight": {
      "type": "string"
    },
    "fontSize": {
      "type": "number"
    },
    "fontSizeTablet": {
      "type": "number"
    },
    "fontSizeMobile": {
      "type": "number"
    },
    "lineHeight": {
      "type": "number"
    },
    "lineHeightTablet": {
      "type": "number"
    },
    "lineHeightMobile": {
      "type": "number"
    },
    "letterSpacing": {
      "type": "number"
    },
    "textTransform": {
      "type": "string"
    },
    "textColor": {
      "type": "string"
    },
    "textAlign": {
      "type": "string"
    },
    "borderStyle": {
      "type": "string",
      "default": "none"
    },
    "borderWidth": {
      "type": "number",
      "default": 1
    },
    "borderColor": {
      "type": "string"
    },
    "borderRadius": {
      "type": "number",
      "default": 0
    },
    "boxShadowEnable": {
      "type": "boolean",
      "default": false
    },
    "boxShadowColor": {
      "type": "string",
      "default": "rgba(0, 0, 0, 0.2)"
    },
    "boxShadowH": {
      "type": "number",
      "default": 0
    },
    "boxShadowV": {
      "type": "number",
      "default": 4
    },
    "boxShadowBlur": {
      "type": "number",
      "default": 12
    },
    "boxShadowSpread": {
      "type": "number",
      "default": 0
    },
    "boxShadowInset": {
      "type": "boolean",
      "default": false
    },
    "hideDesktop": {
      "type": "boolean",
      "default": false
    },
    "hideTablet": {
      "type": "boolean",
      "default": false
    },
    "hideMobile": {
      "type": "boolean",
      "default": false
    },
    "hideLoggedIn": {
      "type": "boolean",
      "default": false
    },
    "hideLoggedOut": {
      "type": "boolean",
      "default": false
    }
  }
}
{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "skt-blocks/skt-tabs",
  "title": "Tabs",
  "category": "skt_blocks",
  "description": "Tabbed content with a horizontal or vertical layout. Add as many tabs as you need.",
  "keywords": [
    "tabs",
    "tab",
    "tabbed",
    "vertical tabs",
    "content switcher"
  ],
  "textdomain": "skt-blocks",
  "supports": {
    "anchor": true,
    "customClassName": true,
    "html": false,
    "align": [
      "wide",
      "full"
    ],
    "reusable": true
  },
  "attributes": {
    "uniqueId": {
      "type": "string",
      "default": ""
    },
    "tabs": {
      "type": "array",
      "default": [
        {
          "title": "Tab 1",
          "icon": ""
        },
        {
          "title": "Tab 2",
          "icon": ""
        },
        {
          "title": "Tab 3",
          "icon": ""
        }
      ]
    },
    "styleDesktop": {
      "type": "number",
      "default": 1
    },
    "styleTablet": {
      "type": "number"
    },
    "styleMobile": {
      "type": "number"
    },
    "initialTab": {
      "type": "number",
      "default": 1
    },
    "tabAlign": {
      "type": "string",
      "default": "flex-start"
    },
    "textAlign": {
      "type": "string",
      "default": "center"
    },
    "navWidth": {
      "type": "number",
      "default": 25
    },
    "tabGap": {
      "type": "number",
      "default": 4
    },
    "animation": {
      "type": "string",
      "default": "fade"
    },
    "animationDuration": {
      "type": "number",
      "default": 0.3
    },
    "tabTransition": {
      "type": "number",
      "default": 0.2
    },
    "iconPosition": {
      "type": "string",
      "default": "before"
    },
    "iconSize": {
      "type": "number",
      "default": 18
    },
    "iconSizeTablet": {
      "type": "number"
    },
    "iconSizeMobile": {
      "type": "number"
    },
    "iconSpacing": {
      "type": "number",
      "default": 8
    },
    "iconColor": {
      "type": "string"
    },
    "iconActiveColor": {
      "type": "string"
    },
    "fontFamily": {
      "type": "string"
    },
    "fontWeight": {
      "type": "string",
      "default": "500"
    },
    "fontSize": {
      "type": "number",
      "default": 16
    },
    "fontSizeTablet": {
      "type": "number"
    },
    "fontSizeMobile": {
      "type": "number"
    },
    "lineHeight": {
      "type": "number"
    },
    "lineHeightTablet": {
      "type": "number"
    },
    "lineHeightMobile": {
      "type": "number"
    },
    "letterSpacing": {
      "type": "number"
    },
    "textTransform": {
      "type": "string",
      "default": "none"
    },
    "titlePaddingV": {
      "type": "number",
      "default": 14
    },
    "titlePaddingVTablet": {
      "type": "number"
    },
    "titlePaddingVMobile": {
      "type": "number"
    },
    "titlePaddingH": {
      "type": "number",
      "default": 24
    },
    "titlePaddingHTablet": {
      "type": "number"
    },
    "titlePaddingHMobile": {
      "type": "number"
    },
    "titleColor": {
      "type": "string",
      "default": "#555555"
    },
    "titleBg": {
      "type": "string",
      "default": "#f3f4f6"
    },
    "titleHoverColor": {
      "type": "string"
    },
    "titleHoverBg": {
      "type": "string"
    },
    "titleActiveColor": {
      "type": "string",
      "default": "#ffffff"
    },
    "titleActiveBg": {
      "type": "string",
      "default": "#2563eb"
    },
    "titleActiveHoverColor": {
      "type": "string"
    },
    "titleActiveHoverBg": {
      "type": "string"
    },
    "tabBorderStyle": {
      "type": "string",
      "default": "none"
    },
    "tabBorderWidth": {
      "type": "number",
      "default": 1
    },
    "tabBorderRadius": {
      "type": "number"
    },
    "tabBorderColor": {
      "type": "string"
    },
    "tabBorderHoverColor": {
      "type": "string"
    },
    "tabActiveBorderColor": {
      "type": "string"
    },
    "tabActiveBorderHoverColor": {
      "type": "string"
    },
    "backgroundType": {
      "type": "string",
      "default": "none"
    },
    "backgroundColor": {
      "type": "string"
    },
    "gradientColor": {
      "type": "string"
    },
    "backgroundImageUrl": {
      "type": "string"
    },
    "backgroundImageId": {
      "type": "number"
    },
    "backgroundPosition": {
      "type": "string",
      "default": "center center"
    },
    "backgroundSize": {
      "type": "string",
      "default": "cover"
    },
    "backgroundRepeat": {
      "type": "string",
      "default": "no-repeat"
    },
    "backgroundAttachment": {
      "type": "string",
      "default": "scroll"
    },
    "marginTop": {
      "type": "number",
      "default": 0
    },
    "marginBottom": {
      "type": "number",
      "default": 0
    },
    "marginTopTablet": {
      "type": "number"
    },
    "marginTopMobile": {
      "type": "number"
    },
    "marginBottomTablet": {
      "type": "number"
    },
    "marginBottomMobile": {
      "type": "number"
    },
    "tabPaddingTop": {
      "type": "number"
    },
    "tabPaddingTopTablet": {
      "type": "number"
    },
    "tabPaddingTopMobile": {
      "type": "number"
    },
    "tabPaddingRight": {
      "type": "number"
    },
    "tabPaddingRightTablet": {
      "type": "number"
    },
    "tabPaddingRightMobile": {
      "type": "number"
    },
    "tabPaddingBottom": {
      "type": "number"
    },
    "tabPaddingBottomTablet": {
      "type": "number"
    },
    "tabPaddingBottomMobile": {
      "type": "number"
    },
    "tabPaddingLeft": {
      "type": "number"
    },
    "tabPaddingLeftTablet": {
      "type": "number"
    },
    "tabPaddingLeftMobile": {
      "type": "number"
    },
    "tabMarginTop": {
      "type": "number"
    },
    "tabMarginTopTablet": {
      "type": "number"
    },
    "tabMarginTopMobile": {
      "type": "number"
    },
    "tabMarginRight": {
      "type": "number"
    },
    "tabMarginRightTablet": {
      "type": "number"
    },
    "tabMarginRightMobile": {
      "type": "number"
    },
    "tabMarginBottom": {
      "type": "number"
    },
    "tabMarginBottomTablet": {
      "type": "number"
    },
    "tabMarginBottomMobile": {
      "type": "number"
    },
    "tabMarginLeft": {
      "type": "number"
    },
    "tabMarginLeftTablet": {
      "type": "number"
    },
    "tabMarginLeftMobile": {
      "type": "number"
    },
    "hideDesktop": {
      "type": "boolean",
      "default": false
    },
    "hideTablet": {
      "type": "boolean",
      "default": false
    },
    "hideMobile": {
      "type": "boolean",
      "default": false
    },
    "hideLoggedIn": {
      "type": "boolean",
      "default": false
    },
    "hideLoggedOut": {
      "type": "boolean",
      "default": false
    },
    "navPaddingTop": {
      "type": "number"
    },
    "navPaddingTopTablet": {
      "type": "number"
    },
    "navPaddingTopMobile": {
      "type": "number"
    },
    "navPaddingBottom": {
      "type": "number"
    },
    "navPaddingBottomTablet": {
      "type": "number"
    },
    "navPaddingBottomMobile": {
      "type": "number"
    }
  }
}
